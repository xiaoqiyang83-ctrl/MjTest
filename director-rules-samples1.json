{
  "version": "2.0",
  "director_core_rules": {
    "goal": "强化AI漫剧的导演感、爽点节奏、情绪推进、镜头语言与留存能力",
    "style": "国漫、末世、压迫感、电影化、爽感强化",
    "global_rules": [
      "禁止一句对白对应一个镜头",
      "高潮前必须有停顿镜头",
      "重要爽点必须使用特写",
      "压迫场景优先使用低机位",
      "情绪变化必须递进",
      "每集结尾必须有Hook镜头",
      "镜头节奏必须有快慢变化",
      "普通对白禁止连续三个平视镜头"
    ]
  },

  "shot_priority_rules": {
    "S_LEVEL": {
      "description": "高潮镜头/爆点镜头",
      "rules": [
        "必须使用特写或超近景",
        "允许静止停顿0.5-2秒",
        "必须强化角色表情",
        "允许加入能量、阴影、压迫感特效",
        "镜头数量可增加"
      ]
    },

    "A_LEVEL": {
      "description": "情绪推进镜头",
      "rules": [
        "必须体现角色心理变化",
        "优先中近景",
        "允许推镜"
      ]
    },

    "B_LEVEL": {
      "description": "过渡镜头",
      "rules": [
        "镜头时长缩短",
        "减少复杂运镜",
        "用于推进剧情"
      ]
    }
  },

  "emotion_curve_rules": {
    "standard_curve": [
      "平静",
      "压抑",
      "怀疑",
      "危险感",
      "愤怒",
      "爆发",
      "反杀",
      "短暂平静",
      "新危机"
    ],

    "rules": [
      "禁止情绪连续平稳超过4镜",
      "高潮前必须提升压迫感",
      "爆发镜头后必须留情绪余波",
      "重要反转必须有停顿镜头"
    ]
  },

  "camera_language_rules": {
    "low_angle": {
      "usage": [
        "主角觉醒",
        "强者压迫",
        "反杀",
        "Boss登场"
      ],
      "effect": "强化压迫感与力量感"
    },

    "close_up": {
      "usage": [
        "愤怒",
        "杀意",
        "震惊",
        "爆点停顿"
      ],
      "effect": "强化情绪"
    },

    "push_in": {
      "usage": [
        "危险靠近",
        "情绪积累",
        "觉醒前夕"
      ],
      "effect": "强化紧张感"
    },

    "wide_shot": {
      "usage": [
        "末世环境",
        "大战前",
        "孤独感"
      ],
      "effect": "强化世界观"
    },

    "top_down": {
      "usage": [
        "弱势",
        "压迫",
        "绝望"
      ],
      "effect": "制造压迫感"
    }
  },

  "hook_rules": {
    "mandatory": true,
    "rules": [
      "每集最后一个镜头必须制造悬念",
      "禁止平淡结束",
      "Hook镜头优先使用特写",
      "Hook信息不能完全解释清楚"
    ],

    "hook_examples": [
      "门后突然出现黑影",
      "系统突然报警",
      "角色瞳孔骤缩",
      "尸潮突然转头",
      "Boss现身",
      "通讯器突然传来惨叫"
    ]
  },

  "action_scene_rules": {
    "rules": [
      "战斗前必须有蓄力镜头",
      "战斗中必须穿插特写",
      "禁止连续5镜同角度",
      "重要攻击必须放慢节奏",
      "反杀镜头必须强化压迫感"
    ]
  },

  "dialogue_rules": {
    "rules": [
      "对白必须短句化",
      "禁止长段解释",
      "主角对白必须冷感",
      "反派对白必须有压迫感",
      "爽点前减少对白"
    ]
  },

  "storyboard_examples": [
    {
      "scene_type": "主角觉醒",
      "priority": "S_LEVEL",
      "emotion": "愤怒→爆发",
      "camera": [
        "低机位",
        "特写",
        "推镜"
      ],
      "rhythm": [
        "停顿",
        "能量积蓄",
        "突然爆发"
      ]
    },

    {
      "scene_type": "Boss压迫登场",
      "priority": "A_LEVEL",
      "camera": [
        "广角",
        "低机位",
        "阴影遮挡"
      ],
      "emotion": "压迫感",
      "rhythm": [
        "缓慢推进",
        "环境安静",
        "角色紧张"
      ]
    },

    {
      "scene_type": "Hook结尾",
      "priority": "S_LEVEL",
      "camera": [
        "特写",
        "静止镜头"
      ],
      "emotion": "危险",
      "rhythm": [
        "突然停顿",
        "黑屏结束"
      ]
    }
  ]
}